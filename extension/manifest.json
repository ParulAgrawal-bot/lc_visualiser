{
  "manifest_version": 3,
  "name": "LeetCode Visualizer + Hint",
  "version": "0.1.0",
  "description": "Understand LeetCode problems with animated examples and progressive hints.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://leetcode.com/problems/*", "http://localhost:8787/*"],
  "background": {"service_worker": "src/background/index.ts", "type": "module"},
  "content_scripts": [{"matches": ["https://leetcode.com/problems/*"], "js": ["src/content/index.tsx"], "run_at": "document_idle"}],
  "action": {"default_title": "Open LeetCode Visualizer"}
}
