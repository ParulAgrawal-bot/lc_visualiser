PORT=8787
# Groq is OpenAI-compatible. Create a key at https://console.groq.com/keys.
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
# Optional if FFmpeg is not on PATH. Set this to its bin folder or ffmpeg.exe path.
FFMPEG_BIN=
# Optional path to the Python installation that has Manim and edge-tts installed.
PYTHON_BIN=
# Optional Edge TTS voice (default: en-US-AriaNeural).
TTS_VOICE=en-US-AriaNeural
# Optional: set LLM_PROVIDER=openai and LLM_API_KEY to use OpenAI instead.
LLM_API_KEY=
